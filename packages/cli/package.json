{
  "name": "@tourguide/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tourguide": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tourguide/core": "workspace:*",
    "@tourguide/schema": "workspace:*",
    "@tourguide/tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
