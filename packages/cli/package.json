{
  "name": "@elic/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "elic": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/cli": "latest",
    "@effect/platform-node": "latest",
    "@elic/core": "workspace:*",
    "@elic/schema": "workspace:*",
    "effect": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
